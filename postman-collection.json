{
  "info": {
    "name": "Subscription Service API",
    "description": "Subscription Service API. Includes Reminder batches (CRM) at /api/v1/reminder-batches — JWT must carry userType CRM (or gateway x-user-type: CRM). Import reminder-batches.postman_collection.json for subscription + account internal eligibility in one file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "profileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "subscriptionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "templateId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reminderBatchId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
