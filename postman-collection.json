    {
      "name": "Subscriptions (CRM)",
      "item": [
        {
          "name": "List subscriptions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions?profileId={{profileId}}&applicationId=&isCurrent=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions"],
              "query": [
                {
                  "key": "profileId",
                  "value": "{{profileId}}",
                  "description": "Optional ObjectId filter"
                },
                {
                  "key": "applicationId",
                  "value": "",
                  "description": "Optional application id"
                },
                {
                  "key": "isCurrent",
                  "value": "",
                  "description": "true | false"
                }
              ]
            },
            "description": "CRM only. Optional query: profileId, applicationId, isCurrent."
          }
        },
        {
          "name": "Get subscription by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "{{subscriptionId}}"]
            },
            "description": "CRM only. Enriched shape (profile + payments aggregation)."
          }
        },
        {
          "name": "Get subscriptions by profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/profile/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "profile", "{{profileId}}"]
            },
            "description": "Auth or gateway-internal. All subscriptions for profile."
          }
        },
        {
          "name": "Get current subscription by profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/profile/{{profileId}}/current",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "subscriptions",
                "profile",
                "{{profileId}}",
                "current"
              ]
            },
            "description": "Auth or gateway-internal. Current active subscription only."
          }
        },
        {
          "name": "Get subscriptions by profile (internal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-internal-request",
                "value": "true"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/profile/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "profile", "{{profileId}}"]
            },
            "description": "Service-to-service: x-internal-request without Bearer."
          }
        },
        {
          "name": "Filter subscriptions (template)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 25,\n  \"templateId\": \"{{templateId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/filter",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "filter"]
            },
            "description": "CRM only. Body: page, limit, optional templateId (Mongo id). Omit templateId to use default template."
          }
        },
        {
          "name": "Update subscription by id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membershipCategory\": \"Associate\",\n  \"subscriptionStartDate\": \"2026-01-15\",\n  \"paymentType\": \"Salary Deduction\",\n  \"payrollNo\": \"P12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "{{subscriptionId}}"]
            },
            "description": "CRM only. Partial update: membershipCategory, subscriptionStartDate (or startDate), paymentType, payrollNo. Optional adjustmentKey for idempotent GL when category changes. paymentType: Salary Deduction | Direct Debit | Credit Card | Standing Order."
          }
        }
      ]
    },
