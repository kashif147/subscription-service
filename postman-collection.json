    {
      "name": "Reminder batches (CRM)",
      "description": "Requires CRM userType on JWT (Bearer) or gateway headers. Always send x-tenant-id with Bearer if tenant is not only inside the token. After Create, copy _id into {{reminderBatchId}} for build/execute/members/get.",
      "item": [
        {
          "name": "Create reminder batch (REMINDER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"April 2026 reminder run\",\n  \"kind\": \"REMINDER\",\n  \"batchDate\": \"2026-04-18T12:00:00.000Z\",\n  \"referencePeriod\": \"2026-04\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reminder-batches"]
            },
            "description": "kind: REMINDER | CANCELLATION. Optional previousReminderBatchId (ObjectId string)."
          }
        },
        {
          "name": "Create reminder batch (CANCELLATION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"April 2026 cancellation batch\",\n  \"kind\": \"CANCELLATION\",\n  \"batchDate\": \"2026-04-18T12:00:00.000Z\",\n  \"referencePeriod\": \"2026-04\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reminder-batches"]
            }
          }
        },
        {
          "name": "List reminder batches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches?kind=&status=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reminder-batches"],
              "query": [
                {
                  "key": "kind",
                  "value": "",
                  "description": "REMINDER or CANCELLATION"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "draft | pending_build | ready | executing | completed | failed | superseded"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get reminder batch by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches/{{reminderBatchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reminder-batches", "{{reminderBatchId}}"]
            }
          }
        },
        {
          "name": "List reminder batch members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches/{{reminderBatchId}}/members?tier=&included=&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "reminder-batches",
                "{{reminderBatchId}}",
                "members"
              ],
              "query": [
                {
                  "key": "tier",
                  "value": "",
                  "description": "R1 | R2 | R3 | CANCEL"
                },
                {
                  "key": "included",
                  "value": "",
                  "description": "true | false"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Build reminder batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches/{{reminderBatchId}}/build",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "reminder-batches",
                "{{reminderBatchId}}",
                "build"
              ]
            },
            "description": "Requires ACCOUNT_SERVICE_URL + ACCOUNTS_API_KEY on subscription-service. Writes reminderbatchmembers."
          }
        },
        {
          "name": "Execute reminder batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reminder-batches/{{reminderBatchId}}/execute",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "reminder-batches",
                "{{reminderBatchId}}",
                "execute"
              ]
            },
            "description": "Batch must be ready. Side-effects on subscriptions + events for cancellation."
          }
        }
      ]
    },
    {
      "name": "Membership Lifecycle",
      "item": [
        {
          "name": "Resign Membership (by subscriptionId)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateResigned\": \"2026-03-30T00:00:00.000Z\",\n  \"reason\": \"Member requested resignation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}/resign",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "subscriptions",
                "{{subscriptionId}}",
                "resign"
              ]
            },
            "description": "Preferred: targets the subscription Mongo _id. Only succeeds when the row is current and Active."
          }
        },
        {
          "name": "Undo Resign Membership (by subscriptionId)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"admin_error\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/{{subscriptionId}}/undo-resign",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "subscriptions",
                "{{subscriptionId}}",
                "undo-resign"
              ]
            },
            "description": "Preferred: undo resignation for the subscription Mongo _id that is Resigned with resignation details."
          }
        },
        {
          "name": "Resign Membership (legacy — by profileId)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateResigned\": \"2026-03-30T00:00:00.000Z\",\n  \"reason\": \"Member requested resignation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/resign/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "resign", "{{profileId}}"]
            },
            "description": "Resolves this profile's current active subscription and delegates to the same logic as resign by subscriptionId."
          }
        },
        {
          "name": "Undo Resign Membership (legacy — by profileId)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"admin_error\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/undo-resign/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "subscriptions",
                "undo-resign",
                "{{profileId}}"
              ]
            },
            "description": "Finds the most recently resigned subscription for the profile and delegates to undo by subscriptionId."
          }
        },
        {
          "name": "Cancel Membership",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateCancelled\": \"2026-03-30T00:00:00.000Z\",\n  \"reason\": \"Member requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/cancel/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "subscriptions", "cancel", "{{profileId}}"]
            }
          }
        },
        {
          "name": "Undo Cancel Membership",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "x-tenant-id",
                "value": "{{tenantId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscriptions/undo-cancel/{{profileId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "subscriptions",
                "undo-cancel",
                "{{profileId}}"
              ]
            }
          }
        }
      ]
    }
  ]
